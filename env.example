# SULFS Creative Studio Environment Configuration

# 1. Google Gemini API Key
# Required for Gemini AI video operations. Configure via the Secrets tab in Google AI Studio.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 2. Application Deployment URL
# Automatically set by the hosting platform or set to your custom domain.
APP_URL="MY_APP_URL"

# 3. Secure SMTP Mail Configuration (For Customer Enquiries)
# Set the SMTP host server of your email provider (e.g., smtp.office365.com for Outlook, smtp.resend.com for Resend, smtp.gmail.com for Gmail, smtp.brevo.com for Brevo)
SMTP_HOST="smtp.office365.com"

# SMTP port (typically 587 for STARTTLS/TLS, or 465 for SSL/implicit TLS)
SMTP_PORT=587

# Use secure connection (set "true" for port 465 SSL, or "false" for port 587 TLS)
SMTP_SECURE="false"

# The authenticated email address authorized by your SMTP server to dispatch mail
SMTP_USER="SulfsCreativeStudio@outlook.com"

# The authenticated SMTP password or specialized APP PASSWORD (strongly recommended over normal passwords)
SMTP_PASS="YOUR_SECURE_APP_PASSWORD_OR_TOKEN"

# 4. Campaign Enquiry Receiver (SULFS Production Inbox)
# All custom website lead forms are securely routed here. Defaults to SulfsCreativeStudio@outlook.com
CONTACT_RECEIVER_EMAIL="SulfsCreativeStudio@outlook.com"
